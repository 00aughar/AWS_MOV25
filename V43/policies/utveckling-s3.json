{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KonsolNavigering",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation"],
      "Resource": "*"
    },
    {
      "Sid": "ListaNovatrixBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::novatrix-data-00aughar-01"
    },
    {
      "Sid": "LasaObjekt",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::novatrix-data-00aughar-01/*"
    }
  ]
}
